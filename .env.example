# Copy this file to .env and supply credentials locally.
GNANI_API_KEY=replace_with_your_gnani_api_key
VAANISHIELD_ACTION_TOKEN=replace_with_a_long_random_token
VAANISHIELD_DEMO_SESSION_SECRET=replace_with_at_least_32_random_bytes
# Set true when serving the demo API over HTTPS; false is for local HTTP only.
VAANISHIELD_DEMO_COOKIE_SECURE=false
VAANISHIELD_TIMBRE_VOICE_EN_IN=Kaveri
VAANISHIELD_TIMBRE_VOICE_HI_IN=replace_with_supported_hindi_voice
# Timbre v2.5 Kannada default voice. Set Shivani only with the legacy v3 adapter.
VAANISHIELD_TIMBRE_VOICE_KN_IN=Kavin
# TTS selection is independent of VAANISHIELD_STT_PROVIDER and VAANISHIELD_LLM_PROVIDER.
# Timbre v2.5 is the default; gnani_v3_legacy selects the existing v3 adapter.
# VAANISHIELD_TTS_PROVIDER=gnani

# Primary assistant reasoning provider (Groq is the default).
VAANISHIELD_LLM_PROVIDER=groq
VAANISHIELD_LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=replace_with_your_groq_api_key

# Secondary assistant reasoning provider (uncomment and set together to use Gemini).
# VAANISHIELD_LLM_PROVIDER=gemini
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=replace_with_your_gemini_api_key

# Optional speech-to-text provider; this is independent of the LLM provider.
# Set VAANISHIELD_STT_PROVIDER=groq to use Groq Whisper. GROQ_API_KEY is shared.
# Prisma is selected by default; set VAANISHIELD_STT_PROVIDER=prisma to make it explicit.
# VAANISHIELD_STT_PROVIDER=prisma
# VAANISHIELD_STT_PROVIDER=groq

# Optional Prisma v3 request tuning; unset values use VaaniShield banking defaults.
# The REST API sends the preferred languages in its language_code field.
# VAANISHIELD_PRISMA_FORMAT=transcribe
# VAANISHIELD_PRISMA_LANGUAGE_CANDIDATES=en-IN,kn-IN,hi-IN
# Override optional lists with JSON arrays. Prisma accepts up to 200 keyterms and 4 names.
# VAANISHIELD_PRISMA_KEYTERMS=["UPI","IMPS","NEFT"]
# VAANISHIELD_PRISMA_TOPIC=Banking, transactions, financial security, and multilingual support.
# VAANISHIELD_PRISMA_SPEAKER_NAMES=["Arjun Sharma","Priya Nair","Rahul Verma"]
